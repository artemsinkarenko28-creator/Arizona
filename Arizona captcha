.top-table th{color:#ffaa00;background:#151518;}
.toggle-container{margin-bottom:15px;font-size:13px;display:flex;justify-content:center;align-items:center;gap:10px;color:#a4b0be;}
.stats-panel{position:fixed;bottom:20px;right:20px;background:rgba(34,34,39,0.95);padding:15px;border:1px solid #5a5a62;border-radius:5px;font-size:13px;width:230px;box-shadow:0 5px 15px rgba(0,0,0,0.5);}
.stats-title{color:#ffaa00;font-weight:bold;margin-bottom:8px;text-align:center;text-transform:uppercase;font-size:11px;letter-spacing:1px;}
.stats-row{display:flex;justify-content:space-between;margin:4px 0;color:#dcdde1;}
