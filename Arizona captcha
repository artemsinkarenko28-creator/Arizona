<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Игровое Меню сайта</title>
    <style>
        /* Базовые стили для страницы сайта */
        body {
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background: #141419;
            color: #ffffff;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
        }

        .welcome-text {
            text-align: center;
            font-size: 20px;
            color: #8a8a98;
        }

        /* Кнопка-подсказка на экране */
        .hint-key {
            display: inline-block;
            background: #22222a;
            color: #00ff88;
            border: 2px solid #00ff88;
            border-radius: 8px;
            padding: 10px 20px;
            font-size: 24px;
            font-weight: bold;
            margin-top: 15px;
            box-shadow: 0 0 15px rgba(0, 255, 136, 0.3);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }

        /* ТЕМНЫЙ ФОН ЗА ОКНОМ (БЛЮР) */
        .modal-overlay {
            display: none; /* Изначально скрыто */
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(6px);
            justify-content: center;
            align-items: center;
            z-index: 9999;
            opacity: 0;
            transition: opacity 0.25s ease;
        }

        /* Класс для плавной анимации появления */
        .modal-overlay.active {
            display: flex;
            opacity: 1;
        }

        /* ОКНО ИГРОВОГО МЕНЮ */
        .menu-window {
            background: #1e1e24;
            width: 480px;
            border-radius: 16px;
            border: 2px solid #00ff88;
            box-shadow: 0 0 30px rgba(0, 255, 136, 0.25);
            overflow: hidden;
            transform: scale(0.85);
            transition: transform 0.25s ease;
        }

        .modal-overlay.active .menu-window {
            transform: scale(1);
        }

        /* ШАПКА МЕНЮ */
        .menu-header {
            background: #16161a;
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #2d2d38;
        }

        .menu-header h2 {
            margin: 0;
            font-size: 22px;
            letter-spacing: 1px;
            color: #00ff88;
            text-transform: uppercase;
        }

        .close-btn {
            background: none;
            border: none;
            color: #ff4d4d;
            font-size: 32px;
            line-height: 20px;
            cursor: pointer;
            transition: color 0.2s, transform 0.2s;
        }

        .close-btn:hover {
            color: #ff1a1a;
            transform: scale(1.1);
        }

        /* КОНТЕНТ МЕНЮ */
        .menu-body {
            padding: 25px;
        }

        /* БЛОК БАЛАНСА */
        .balance-box {
            background: #111114;
            padding: 18px;
            border-radius: 10px;
            text-align: center;
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 25px;
            border: 1px solid #2d2d38;
        }

        .balance-box span {
            color: #ffd700;
            text-shadow: 0 0 10px rgba(255, 215, 0, 0.4);
        }

        /* СЕТКА С КНОПКАМИ РАЗДЕЛОВ */
        .sections-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        /* КАРТОЧКА РАЗДЕЛА */
        .section-card {
            background: #25252e;
            padding: 20px;
            border-radius: 12px;
            text-align: center;
            cursor: pointer;
            transition: background 0.2s, border-color 0.2s, transform 0.2s;
            border: 1px solid #333344;
        }

        .section-card:hover {
            background: #2d2d3a;
            border-color: #00ff88;
            transform: translateY(-3px);
        }

        .section-card h3 {
            margin: 0 0 8px 0;
            font-size: 18px;
            color: #ffffff;
        }

        .section-card p {
            margin: 0;
            font-size: 13px;
            color: #a0a0b0;
        }
        
        /* Рамка для кастомизации (пример вызова внутри) */
        .section-card.premium {
            border-color: #ff00ff;
        }
        .section-card.premium:hover {
            border-color: #ff00ff;
            box-shadow: 0 0 10px rgba(255, 0, 255, 0.3);
        }
    </style>
</head>
<body>

    <!-- Контент самого сайта (задний план) -->
    <div class="welcome-text">
        <p>Добро пожаловать на игровой сайт!</p>
        <p>Чтобы открыть личный кабинет с балансом и магазином, нажмите:</p>
        <div class="hint-key">Клавишу N</div>
    </div>

    <!-- ВСПЛЫВАЮЩЕЕ ОКНО МЕНЮ (MODAL) -->
    <div class="modal-overlay" id="menuModal">
        <div class="menu-window">
            
            <!-- Шапка -->
            <div class="menu-header">
                <h2>Личный Кабинет</h2>
                <button class="close-btn" id="closeBtn">&times;</button>
            </div>

            <!-- Внутреннее содержимое -->
            <div class="menu-body">
                
                <!-- Отображение Баланса -->
                <div class="balance-box">
                    Баланс: <span id="balanceValue">50,000</span> 💎
                </div>

                <!-- Кнопки функционала сайта -->
                <div class="sections-grid">
                    
                    <!-- Кнопка Казино -->
                    <div class="section-card" onclick="openCasino()">
                        <h3>🎰 Казино</h3>
                        <p>Слоты и рулетка</p>
                    </div>

                    <!-- Кнопка Скинов -->
                    <div class="section-card" onclick="openSkins()">
                        <h3>🎨 Скины</h3>
                        <p>Магазин кастомизации</p>
                    </div>

                    <!-- Кнопка Рамок -->
                    <div class="section-card premium" onclick="openFrames()">
                        <h3>🖼️ Рамки профиля</h3>
                        <p>Эксклюзивные обводки</p>
                    </div>

                    <!-- Кнопка Настроек/Выхода -->
                    <div class="section-card" onclick="toggleMenu()">
                        <h3>❌ Закрыть</h3>
                        <p>Вернуться на сайт</p>
                    </div>

                </div>
            </div>

        </div>
    </div>

    <!-- ЛОГИКА РАБОТЫ (JAVASCRIPT) -->
    <script>
        const modal = document.getElementById('menuModal');
        const closeBtn = document.getElementById('closeBtn');
        const balanceValue = document.getElementById('balanceValue');

        // Глобальная переменная баланса игрока
        let currentBalance = 50000;

        // Переключатель видимости меню
        function toggleMenu() {
            if (modal.classList.contains('active')) {
                modal.classList.remove('active');
                // Задержка скрытия display, чтобы успела отработать анимация CSS
                setTimeout(() => { modal.style.display = 'none'; }, 250);
            } else {
                modal.style.display = 'flex';
                // Небольшой таймаут, чтобы анимация запустилась корректно
                setTimeout(() => { modal.classList.add('active'); }, 10);
            }
        }

        // 1. ОТСЛЕЖИВАНИЕ НАЖАТИЯ КЛАВИШИ N
        document.addEventListener('keydown', function(event) {
            // event.key.toLowerCase() отлавливает и английскую "n", и русскую "т"
            if (event.key.toLowerCase() === 'n' || event.key.toLowerCase() === 'т') {
                
                // Предотвращаем открытие, если пользователь пишет текст в input или textarea
                if (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'TEXTAREA') {
                    return;
                }

                toggleMenu();
            }
        });

        // 2. ЗАКРЫТИЕ ПО КЛИКУ НА КРЕСТИК
        closeBtn.addEventListener('click', toggleMenu);

        // 3. ЗАКРЫТИЕ ПРИ КЛИКЕ НА ТЕМНУЮ ОБЛАСТЬ (МИМО ОКНА)
        modal.addEventListener('click', function(event) {
            if (event.target === modal) {
                toggleMenu();
            }
        });

        // --- ФУНКЦИИ ИГРОВЫХ КНОПОК ---

        function openCasino() {
            // Пример игры в казино: списываем 500 и даем шанс выиграть
            if (currentBalance < 500) {
                alert("Недостаточно алмазов для ставки!");
                return;
            }
            
            currentBalance -= 500;
            let win = Math.random() > 0.5; // 50% шанс победы
            
            if (win) {
                currentBalance += 1500;
                alert("🎰 Вы выиграли 1,500 💎! (Ставка 500 списана)");
            } else {
                alert("🎰 Увы, вы проиграли 500 💎.");
            }
            
            // Обновляем текст баланса на экране
            balanceValue.textContent = currentBalance.toLocaleString();
        }

        function openSkins() {
            alert("🎨 Открывается каталог скинов! Здесь будет выбор ваших моделей.");
        }

        function openFrames() {
            alert("🖼️ Меню выбора рамок: обычная, неоновая, золотая. Применится к вашему аватару.");
        }
    </script>
</body>
</html>
