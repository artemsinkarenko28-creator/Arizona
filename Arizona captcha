const captchaDisplay=document.getElementById('captchaDisplay');const captchaInput=document.getElementById('captchaInput');const sampChat=document.getElementById('sampChat');const chatInputWrapper=document.getElementById('chatInputWrapper');const chatInput=document.getElementById('chatInput');const blindToggle=document.getElementById('blindToggle');const flash=document.getElementById('flash');
let currentBalance=parseInt(localStorage.getItem('arz_balance'))||50000;let generatedCode="",startTime=null,isTyping=false,hasStarted=false,isAdmin=false;let currentTag=localStorage.getItem('arz_user_tag')||"[Player]";let bestTime=localStorage.getItem('arz_best_time')?parseFloat(localStorage.getItem('arz_best_time')):null;let totalInputs=parseInt(localStorage.getItem('arz_total_inputs'))||0,totalSeconds=parseFloat(localStorage.getItem('arz_total_seconds'))||0,totalErrors=parseInt(localStorage.getItem('arz_total_errors'))||0;
