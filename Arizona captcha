<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Игровой Хаб — Ввод Капчи</title>
    <style>
        body {
            font-family: 'Segoe UI', Roboto, sans-serif;
            background: #141419;
            color: #ffffff;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        /* ОКНО ИГРОВОГО МЕНЮ (ВСЕГДА НА ЭКРАНЕ) */
        .menu-window {
            background: #1e1e24;
            width: 480px;
            border-radius: 16px;
            border: 2px solid #00ff88;
            box-shadow: 0 0 30px rgba(0, 255, 136, 0.25);
            overflow: hidden;
        }

        .menu-header {
            background: #16161a;
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #2d2d38;
        }

        .menu-header h2 {
            margin: 0;
            font-size: 22px;
            letter-spacing: 1px;
            color: #00ff88;
            text-transform: uppercase;
        }

        .menu-body {
            padding: 25px;
        }

        /* БЛОК БАЛАНСА */
        .balance-box {
            background: #111114;
            padding: 15px;
            border-radius: 10px;
            text-align: center;
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 20px;
            border: 1px solid #2d2d38;
        }

        .balance-box span {
            color: #ffd700;
            text-shadow: 0 0 10px rgba(255, 215, 0, 0.4);
        }

        /* БЛОК ДЛЯ ВЫВОДА КАПЧИ */
        .captcha-container {
            background: #2a2a35;
            border: 2px dashed #444;
            border-radius: 10px;
            padding: 20px;
            text-align: center;
            margin-bottom: 20px;
        }

        .captcha-code {
            font-size: 36px;
            font-weight: bold;
            letter-spacing: 6px;
            color: #ff00ff;
            background: #111114;
            padding: 10px;
            border-radius: 6px;
            display: inline-block;
            user-select: none;
            text-shadow: 0 0 8px rgba(255, 0, 255, 0.5);
        }

        .hint-text {
            font-size: 14px;
            color: #8a8a98;
            margin-top: 10px;
        }

        .hint-text strong {
            color: #00ff88;
            background: #16161a;
            padding: 2px 6px;
            border-radius: 4px;
        }

        /* ПОЛЕ ВВОДА КАПЧИ */
        .captcha-input {
            width: 100%;
            box-sizing: border-box;
            background: #111114;
            border: 2px solid #333344;
            border-radius: 10px;
            padding: 15px;
            color: #fff;
            font-size: 20px;
            text-align: center;
            letter-spacing: 4px;
            outline: none;
            transition: border-color 0.2s;
        }

        .captcha-input:focus {
            border-color: #00ff88;
            box-shadow: 0 0 10px rgba(0, 255, 136, 0.2);
        }

        /* РАЗДЕЛЫ ДЛЯ ДОПОЛНИТЕЛЬНОГО ФУНКЦИОНАЛА */
        .sections-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-top: 20px;
        }

        .section-card {
            background: #25252e;
            padding: 15px;
            border-radius: 12px;
            text-align: center;
            cursor: pointer;
            transition: background 0.2s, border-color 0.2s;
            border: 1px solid #333344;
        }

        .section-card:hover {
            background: #2d2d3a;
            border-color: #00ff88;
        }

        .section-card h3 {
            margin: 0 0 5px 0;
            font-size: 16px;
            color: #ffffff;
        }

        .section-card p {
            margin: 0;
            font-size: 12px;
            color: #a0a0b0;
        }

        .section-card.premium {
            border-color: #ff00ff;
        }
    </style>
</head>
<body>

    <div class="menu-window">
        <!-- Шапка -->
        <div class="menu-header">
            <h2>Личный Кабинет</h2>
        </div>

        <!-- Контент -->
        <div class="menu-body">
            
            <!-- Баланс игрока -->
            <div class="balance-box">
                Баланс: <span id="balanceValue">50,000</span> 💎
            </div>

            <!-- Зона капчи -->
            <div class="captcha-container">
                <div class="captcha-code" id="captchaDisplay">AB12</div>
                <div class="hint-text">Нажмите клавишу <strong>N</strong>, чтобы начать ввод</div>
            </div>

            <!-- Инпут для ввода -->
            <input type="text" class="captcha-input" id="captchaInput" placeholder="Нажмите N и введите код..." autocomplete="off">

            <!-- Разделы с казино, скинами и рамками -->
            <div class="sections-grid">
                <div class="section-card" onclick="alert('Открываем Казино...')">
                    <h3>🎰 Казино</h3>
                    <p>Слоты и рулетка</p>
                </div>
                <div class="section-card" onclick="alert('Открываем Скины...')">
                    <h3>🎨 Скины</h3>
                    <p>Магазин моделей</p>
                </div>
                <div class="section-card premium" onclick="alert('Открываем Рамки...')">
                    <h3>🖼️ Рамки профиля</h3>
                    <p>Эксклюзивная обводка</p>
                </div>
                <div class="section-card" onclick="generateCaptcha()">
                    <h3>🔄 Обновить</h3>
                    <p>Сменить капчу</p>
                </div>
            </div>
        </div>
    </div>

    <script>
        const captchaDisplay = document.getElementById('captchaDisplay');
        const captchaInput = document.getElementById('captchaInput');
        const balanceValue = document.getElementById('balanceValue');

        let currentBalance = 50000;
        let generatedCode = "";

        // Функция создания случайной капчи из 4 символов (буквы и цифры)
        function generateCaptcha() {
            const chars = "ABCDEFGHJKLMNOPQRSTUVWXYZ123456789"; // Без похожих символов вроде I, O, 0
            let result = "";
            for (let i = 0; i < 4; i++) {
                result += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            generatedCode = result;
            captchaDisplay.textContent = generatedCode;
            captchaInput.value = ""; // Очищаем поле ввода
        }

        // 1. НАЖАТИЕ КЛАВИШИ N ДЛЯ НАЧАЛА ВВОДА
        document.addEventListener('keydown', function(event) {
            // Если фокус НЕ в инпуте, и зажата клавиша N (или русская Т)
            if (document.activeElement !== captchaInput) {
                if (event.key.toLowerCase() === 'n' || event.key.toLowerCase() === 'т') {
                    
                    event.preventDefault(); // Предотвращаем ввод самой буквы 'n' при активации
                    captchaInput.focus();   // Ставим курсор в поле ввода капчи
                }
            }
        });

        // 2. ПРОВЕРКА ВВОДА КАПЧИ
        captchaInput.addEventListener('input', function() {
            // Переводим введенный текст в верхний регистр, чтобы не зависеть от CapsLock
            let userValue = captchaInput.value.toUpperCase();
            
            // Если пользователь ввел нужные 4 символа
            if (userValue.length === 4) {
                if (userValue === generatedCode) {
                    // Успешный ввод: начисляем бонус
                    currentBalance += 1500;
                    balanceValue.textContent = currentBalance.toLocaleString();
                    alert("Успешно! +1,500 💎 на ваш баланс.");
                    
                    captchaInput.blur(); // Убираем фокус с инпута после победы
                    generateCaptcha();   // Создаем новую капчу
                } else {
                    // Ошибка: списываем штраф
                    currentBalance = Math.max(0, currentBalance - 500);
                    balanceValue.textContent = currentBalance.toLocaleString();
                    alert("Неверная капча! -500 💎. Попробуйте еще раз.");
                    
                    captchaInput.value = ""; // Сбрасываем неверный ввод
                }
            }
        });

        // Генерируем первую капчу при загрузке страницы
        generateCaptcha();
    </script>
</body>
</html>
