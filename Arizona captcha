<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Игровое Меню</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #1e1e24;
            color: #fff;
            margin: 0;
            padding: 20px;
        }

        .hint {
            text-align: center;
            font-size: 18px;
            color: #aaaaaa;
            margin-top: 50px;
        }

        .hint strong {
            color: #00ff88;
            background: #2a2a35;
            padding: 5px 10px;
            border-radius: 5px;
            border: 1px solid #444;
        }

        /* Стили для всплывающего окна (модалки) */
        .modal-overlay {
            display: none; /* По умолчанию скрыто */
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(5px);
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .menu-window {
            background: #2a2a35;
            width: 500px;
            border-radius: 12px;
            border: 2px solid #00ff88;
            box-shadow: 0 0 20px rgba(0, 255, 136, 0.2);
            overflow: hidden;
        }

        /* Шапка меню */
        .menu-header {
            background: #22222a;
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #444;
        }

        .menu-header h2 {
            margin: 0;
            font-size: 20px;
            color: #00ff88;
        }

        .close-btn {
            background: none;
            border: none;
            color: #ff4d4d;
            font-size: 24px;
            cursor: pointer;
            transition: 0.2s;
        }

        .close-btn:hover {
            transform: scale(1.2);
        }

        /* Контент меню */
        .menu-body {
            padding: 20px;
        }

        .balance-box {
            background: #1e1e24;
            padding: 15px;
            border-radius: 8px;
            text-align: center;
            font-size: 22px;
            font-weight: bold;
            margin-bottom: 20px;
            border: 1px solid #3a3a4a;
        }

        .balance-box span {
            color: #ffd700;
        }

        /* Сетка разделов (Казино, Скины, Рамки) */
        .sections-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .section-card {
            background: #333344;
            padding: 20px;
            border-radius: 8px;
            text-align: center;
            cursor: pointer;
            transition: 0.3s;
            border: 1px solid transparent;
        }

        .section-card:hover {
            background: #3d3d52;
            border-color: #00ff88;
            transform: translateY(-2px);
        }

        .section-card h3 {
            margin: 0 0 10px 0;
            font-size: 18px;
        }

        .section-card p {
            margin: 0;
            font-size: 12px;
            color: #aaa;
        }
    </style>
</head>
<body>

    <div class="hint">
        Нажмите клавишу <strong>N</strong> на клавиатуре, чтобы открыть/закрыть игровое меню.
    </div>

    <!-- Модальное окно меню -->
    <div class="modal-overlay" id="menuModal">
        <div class="menu-window">
            
            <div class="menu-header">
                <h2>ИГРОВОЙ ХАБ</h2>
                <button class="close-btn" id="closeBtn">&times;</button>
            </div>

            <div class="menu-body">
                <!-- Блок баланса -->
                <div class="balance-box">
                    Ваш баланс: <span id="balanceValue">15,050</span> 💎
                </div>

                <!-- Разделы -->
                <div class="sections-grid">
                    <div class="section-card" onclick="alert('Открываем Казино...')">
                        <h3>🎰 Казино</h3>
                        <p>Слоты, рулетка, краш</p>
                    </div>
                    <div class="section-card" onclick="alert('Открываем Магазин скинов...')">
                        <h3>🎨 Скины</h3>
                        <p>Оружие, одежда, эффекты</p>
                    </div>
                    <div class="section-card" onclick="alert('Открываем Настройки рамок...')">
                        <h3>🖼️ Рамки профиля</h3>
                        <p>Кастомизация аватара</p>
                    </div>
                    <div class="section-card" onclick="alert('Открываем Ежедневные бонусы...')">
                        <h3>🎁 Бонусы</h3>
                        <p>Бесплатные монеты каждый день</p>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <script>
        const modal = document.getElementById('menuModal');
        const closeBtn = document.getElementById('closeBtn');

        // Функция открыть/закрыть меню
        function toggleMenu() {
            if (modal.style.display === 'flex') {
                modal.style.display = 'none';
            } else {
                modal.style.display = 'flex';
            }
        }

        // 1. Отслеживаем нажатие клавиши N
        document.addEventListener('keydown', function(event) {
            // Проверяем, что нажата именно "n" или "N" (работает и на русской раскладке "т")
            if (event.key.toLowerCase() === 'n' || event.key.toLowerCase() === 'т') {
                
                // Если пользователь пишет в каком-то поле ввода (input/textarea), меню не должно открываться
                if (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'TEXTAREA') {
                    return;
                }

                toggleMenu();
            }
        });

        // 2. Закрытие по крестику
        closeBtn.addEventListener('click', toggleMenu);

        // 3. Закрытие при клике на темную область вокруг меню
        modal.addEventListener('click', function(event) {
            if (event.target === modal) {
                toggleMenu();
            }
        });
    </script>
</body>
</html>
