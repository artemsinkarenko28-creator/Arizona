<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Arizona RP Captcha Trainer</title>
    <style>
        /* Шрифт і темне ігрове тло */
        body {
            background-color: #0b0f19;
            background-image: radial-gradient(circle, #151e33 0%, #070a10 100%);
            color: #ffffff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            overflow: hidden;
        }

        /* Головний контейнер у стилі діалогу SAMP (без зовнішніх рамок) */
        .dialog-container {
            background: rgba(12, 16, 28, 0.85);
            box-shadow: 0 0 30px rgba(0, 0, 0, 0.8), inset 0 0 15px rgba(255, 255, 255, 0.05);
            border-radius: 4px;
            padding: 25px;
            width: 420px;
            text-align: center;
            backdrop-filter: blur(10px);
        }

        .dialog-header {
            font-size: 14px;
            font-weight: bold;
            color: #ffa500; /* Класичний помаранчевий колір Arizona */
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 20px;
        }

        /* Вікно самої капчі — БЕЗ РАМОК, просто чистий темний блок */
        .captcha-screen {
            background: rgba(5, 7, 12, 0.9);
            padding: 20px;
            border-radius: 4px;
            margin-bottom: 20px;
        }

        /* Яскраві СИНІ цифри точнісінько як у грі */
        .captcha-digits {
            font-size: 52px;
            font-weight: 900;
            color: #3399ff; /* Фірмовий синій колір лову ARZ */
            letter-spacing: 12px;
            text-shadow: 0 0 15px rgba(51, 153, 255, 0.6);
            user-select: none;
            margin-left: 12px; /* Компенсація трекінгу */
        }

        /* Приховане дефолтне поле та стилізоване відображення вводу */
        .input-display {
            font-size: 24px;
            color: #ffffff;
            background: rgba(255, 255, 255, 0.05);
            border: none;
            outline: none;
            width: 80%;
            padding: 10px;
            text-align: center;
            font-weight: bold;
            letter-spacing: 4px;
            border-bottom: 2px solid #3399ff;
            margin: 10px auto;
        }

        /* Вкладки/Сторінки (ну типу нажимати для перемикання режимів чи меню) */
        .pages-navigation {
            display: flex;
            justify-content: space-between;
            margin-top: 25px;
            gap: 10px;
        }

        .nav-tab {
            flex: 1;
            background: rgba(255, 255, 255, 0.07);
            border: none;
            color: #bbbbbb;
            padding: 10px 5px;
            font-size: 12px;
            font-weight: bold;
            cursor: pointer;
            border-radius: 3px;
            transition: all 0.2s ease;
            text-transform: uppercase;
        }

        .nav-tab:hover {
            background: rgba(51, 153, 255, 0.2);
            color: #ffffff;
        }

        .nav-tab.active {
            background: #3399ff;
            color: #ffffff;
            box-shadow: 0 0 10px rgba(51, 153, 255, 0.4);
        }

        /* Сповіщення про результат */
        .status-message {
            height: 20px;
            font-size: 14px;
            font-weight: bold;
            margin-top: 15px;
        }
        .status-success { color: #2ecc71; }
        .status-error { color: #e74c3c; }
    </style>
</head>
<body>

    <div class="dialog-container">
        <div class="dialog-header">Arizona RP • Ловля Майна</div>
        
        <!-- Капча екран БЕЗ рамок -->
        <div class="captcha-screen">
            <div class="captcha-digits" id="captchaCode">74920</div>
        </div>

        <!-- Поле вводу -->
        <input type="text" class="input-display" id="captchaInput" placeholder="Введіть капчу..." maxlength="5" autocomplete="off" autofocus>
        
        <div class="status-message" id="status"></div>

        <!-- Сторінки "ну типо нажимати" для перемикання -->
        <div class="pages-navigation">
            <button class="nav-tab active" onclick="switchPage(1, this)">Капча 5зн</button>
            <button class="nav-tab" onclick="switchPage(2, this)">PayDay</button>
            <button class="nav-tab" onclick="switchPage(3, this)">Статистика</button>
        </div>
    </div>

    <script>
        const captchaCodeElem = document.getElementById('captchaCode');
        const captchaInputElem = document.getElementById('captchaInput');
        const statusElem = document.getElementById('status');
        
        let currentMode = 1; // 1 = 5 знаків, 2 = PayDay режим

        // Генерація нової капчі
        function generateCaptcha() {
            let length = currentMode === 1 ? 5 : 6; // Робимо 5 або 6 знаків залежно від сторінки
            let result = '';
            for (let i = 0; i < length; i++) {
                result += Math.floor(Math.random() * 10);
            }
            captchaCodeElem.textContent = result;
            captchaInputElem.value = '';
            // Рандомізуємо трохи відстань між синіми цифрами для автентичності ARZ
            captchaCodeElem.style.letterSpacing = (Math.floor(Math.random() * 5) + 10) + 'px';
        }

        // Обробка вводу
        captchaInputElem.addEventListener('input', () => {
            let expectedLength = currentMode === 1 ? 5 : 6;
            
            if (captchaInputElem.value.length === expectedLength) {
                if (captchaInputElem.value === captchaCodeElem.textContent) {
                    statusElem.textContent = "Успішно словлено!";
                    statusElem.className = "status-message status-success";
                    setTimeout(() => {
                        statusElem.textContent = "";
                        generateCaptcha();
                    }, 800);
                } else {
                    statusElem.textContent = "Невірний код! Спробуй ще раз";
                    statusElem.className = "status-message status-error";
                    captchaInputElem.value = '';
                }
            }
        });

        // Логіка кліків по сторінках (меню)
        function switchPage(pageNumber, buttonComponent) {
            // Зміна активної вкладки
            document.querySelectorAll('.nav-tab').forEach(tab => tab.classList.remove('active'));
            buttonComponent.classList.add('active');
            
            currentMode = pageNumber;
            
            if (pageNumber === 1) {
                statusElem.textContent = "Режим: Стандартна капча";
                statusElem.className = "status-message";
                generateCaptcha();
            } else if (pageNumber === 2) {
                statusElem.textContent = "Режим: Тренування PayDay";
                statusElem.className = "status-message";
                generateCaptcha();
            } else if (pageNumber === 3) {
                statusElem.textContent = "Тут будуть твої рекорди введення!";
                statusElem.className = "status-message";
            }
        }

        // Запуск першої капчі при завантаженні
        generateCaptcha();
    </script>
</body>
</html>
